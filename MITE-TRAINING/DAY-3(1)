#include<stdio.h>

void displayages(short int* ages,int len ,int i)
{
    if(i>=len)
    {
        return;
    }

    printf("%d ",ages[i]);
    displayages(ages,len,i+1);
}

void traverseBackwardages(short int* ages,int len,int i)
{
    if(i >= len)
    return ;
    
    traverseBackwardages(ages, len, i+1);
    printf("%d ",ages[i]);
    
}
int main()
{
    short int ages[100];
    int len,i;
    printf("enter the length:");
    scanf("%d",&len);
    
    printf("enter the numbers:");
    for(i=0;i<len;i++)
    {
    scanf("%d",&ages[i]);
    }
   
    displayages(ages,len,0);
    printf("\n");
    traverseBackwardages(ages, len, 0);
    return 0;
}
